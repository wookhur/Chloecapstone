# Copy this file to ".env.local" and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings → API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — connect Google Classroom (read-only import).
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud,
# enable the "Google Classroom API", and add your site to the authorized
# JavaScript origins. Leave blank to use the built-in demo import.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
